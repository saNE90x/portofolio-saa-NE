/system identity
set name=Core-1

/ip address
add address=11.1.2.2/30 interface=ether1 network=11.1.2.0
add address=10.1.2.1/30 interface=ether2 network=10.1.2.0
add address=10.1.1.3 interface=lo network=10.1.1.3
/ip dhcp-client
add interface=ether1

/routing ospf instance
add disabled=no name=instance-v2 router-id=10.1.1.3
/routing ospf area
add disabled=no instance=instance-v2 name=backbone

/routing ospf interface-template
add area=backbone disabled=no interfaces=ether1 networks=11.1.2.0/30
add area=backbone disabled=no interfaces=ether2 networks=10.1.2.0/30
add area=backbone disabled=no interfaces=lo networks=10.1.1.3/32


/routing bgp template
add as=1200 name=core-1 router-id=10.1.1.3

/routing bgp connection
add connect=yes local.role=ibgp-rr-client name=To-RR-1 remote.address=10.1.1.1 .as=1200 templates=core-1
add connect=yes local.role=ibgp-rr-client name=To-RR-2 remote.address=10.1.1.2 .as=1200 templates=core-1

