/system identity
set name=Core-2

/ip address
add address=15.1.2.2/30 interface=ether1 network=15.1.2.0
add address=17.1.1.1/30 interface=ether2 network=17.1.1.0
add address=10.1.1.4 interface=lo network=10.1.1.4
/ip dhcp-client
add interface=ether1

/routing ospf instance
add disabled=no name=instance-v2 router-id=10.1.1.4
/routing ospf area
add disabled=no instance=instance-v2 name=backbone
/routing ospf interface-template
add area=backbone disabled=no interfaces=ether1 networks=15.1.2.0/30
add area=backbone disabled=no interfaces=ether2 networks=17.1.1.0/30
add area=backbone disabled=no interfaces=lo networks=10.1.1.4/32


/routing bgp template
add as=1200 name=core-2 router-id=10.1.1.4

/routing bgp connection
add connect=yes local.role=ibgp-rr-client name=To-RR-1 remote.address=10.1.1.1 .as=1200 templates=core-2
add connect=yes local.role=ibgp-rr-client name=To-RR-2 remote.address=10.1.1.2 .as=1200 templates=core-2
