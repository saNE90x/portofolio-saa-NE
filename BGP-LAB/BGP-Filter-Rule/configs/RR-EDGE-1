/system identity
set name=RR-1
[admin@RR-1] > 



/ip address
add address=11.1.1.2/30 interface=ether1 network=11.1.1.0
add address=11.1.2.1/30 interface=ether2 network=11.1.2.0
add address=10.1.1.1 interface=lo network=10.1.1.1
add address=14.14.14.1/30 interface=ether3 network=14.14.14.0
/ip dhcp-client
add interface=ether1

/routing ospf instance
add disabled=no name=instance-v2 router-id=10.1.1.1
/routing ospf area
add disabled=no instance=instance-v2 name=backbone

/routing ospf interface-template
add area=backbone disabled=no interfaces=ether2 networks=11.1.2.0/30
add area=backbone disabled=no interfaces=lo networks=10.1.1.1/32
add area=backbone disabled=no interfaces=ether3 networks=14.14.14.0/30


/ip firewall address-list
add address=11.1.1.0/30 list=rr-1-lan
add address=11.1.2.0/30 list=rr-1-lan
add address=10.1.1.1 list=rr-1-lan
add address=10.0.0.0/8 list=BOGON-PREFIX
add address=172.16.0.0/12 list=BOGON-PREFIX
add address=192.168.0.0/16 list=BOGON-PREFIX
add address=127.0.0.0/8 list=BOGON-PREFIX
add address=169.254.0.0/16 list=BOGON-PREFIX
add address=103.10.10.0/24 list=AS6500-PUBLIC
#digunakan agar router luar tidak bisa mengadvertise ip yang sama dengan internal
add list=AS1200-INTERNAL address=103.10.10.0/24 comment="Blok Publik Internal"
add list=AS1200-INTERNAL address=10.1.1.0/24 comment="Loopback Internal AS1200"
add list=AS1200-INTERNAL address=10.1.2.0/30 comment="PtP Core-1 - Core-LAN"
add list=AS1200-INTERNAL address=11.1.2.0/30 comment="PtP RR-1 - Core-1"
add list=AS1200-INTERNAL address=14.14.14.0/30 comment="PtP RR-1 - RR-2"
add list=AS1200-INTERNAL address=15.1.2.0/30 comment="PtP RR-2 - Core-2"
add list=AS1200-INTERNAL address=17.1.1.0/30 comment="PtP Core-2 - Core-LAN"

/routing bgp template
add as=1200 name=rr-1 router-id=10.1.1.1

/routing bgp connection
add as=1200 connect=yes input.filter=bgp-in-isp local.role=ibgp name=rr-1-to-iBGP-rr-2 output.filter-chain=bgp-out-isp \
.network=AS6500-PUBLIC remote.address=14.14.14.2 .as=1200 templates=rr-1

add as=1200 connect=yes local.role=ebgp name=RR-1-To-eBGP remote.address=11.1.1.1 .as=100 templates=rr-1

add listen=yes local.role=ibgp-rr name=RR-Edge-1 nexthop-choice=force-self output.default-originate=always remote.address=\
10.1.1.0/24 .as=1200 templates=rr-1

/routing filter rule
add chain=bgp-in-isp rule="if (bgp-as-path 1200) {reject}"
add chain=bgp-in-isp rule="if (dst in BOGON-PREFIX ) {reject}"
add chain=bgp-in-isp rule="if (dst in AS1200-INTERNAL) { reject }"
add chain=bgp-in-isp rule=accept
add chain=bgp-out-isp rule="if (dst == 103.10.10.0/24 ) {accept}"
add chain=bgp-out-isp rule=reject

